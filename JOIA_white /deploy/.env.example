# ─────────────────────────────────────────────────────────────────────────────
# CLUB JOIA 300 (white edition) — server settings
# Copy this file to .env on the server and fill it in. Never upload a filled-in .env anywhere else.
# Settings starting with "# " are optional: remove the "# " to use one, leave it otherwise
# (an empty value is not the same as unset and can fail validation).
# ─────────────────────────────────────────────────────────────────────────────

# Public address of the site. Must be https:// — sign-in cookies are "Secure" and browsers drop
# them on plain http (except on localhost).
NEXT_PUBLIC_APP_URL="https://test.your-domain.example"

# PostgreSQL 14+ connection string.
DATABASE_URL="postgres://joia:CHANGE_ME_DB_PASSWORD@localhost:5432/joia"

# Two different random secrets, 32+ characters each. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
QR_SIGNING_SECRET=""
QR_TOKEN_TTL_SECONDS=300

# Where the app listens. Keep 127.0.0.1 when a reverse proxy (Caddy / nginx) runs on the same
# server.
PORT=3000
BIND_ADDRESS="127.0.0.1"

# Uploaded images and attachments are stored in this folder (relative to the app folder).
# Keep it when you upload a new release.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="data/uploads"

# Email: "console" only writes emails to the server log (nothing is delivered).
# For real delivery use "smtp" with SMTP_URL, or "resend" with RESEND_API_KEY.
EMAIL_DRIVER="console"
EMAIL_FROM="CLUB JOIA 300 <no-reply@your-domain.example>"
# SMTP_URL=""
# RESEND_API_KEY=""

# WhatsApp staff alerts: "console" (log only) or "twilio".
WHATSAPP_DRIVER="console"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM=""
# TWILIO_WHATSAPP_CONTENT_SID=""

# Optional web push (generate locally with: npm run push:keys). Empty = push shown as not configured.
# WEB_PUSH_PUBLIC_KEY=""
# WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:concierge@your-domain.example"

# Optional: bearer secret for GET /api/cron/notifications (scheduled notifications), 16+ chars.
# CRON_SECRET=""
