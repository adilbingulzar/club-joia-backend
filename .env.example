# ─────────────────────────────────────────────────────────────────────────────
# CLUB JOIA 300 — environment variables
# Copy to .env for local development. NEVER commit real values.
# Production values belong in the server's .env (see Deployment in README.md).
# ─────────────────────────────────────────────────────────────────────────────

# MySQL 8.0.13+ connection string (runtime + migrations). MariaDB 10.6+ also works.
# The database must use utf8mb4. The app forces every connection to
# UTC itself, so the server's time zone does not matter. Special characters in the password must
# be URL-encoded (e.g. @ → %40).
# Database name is free to choose (the live server can use a different one than local).
# Tests reuse this server and user but never touch this database: they create and drop their own
# joia_it_* / joia_e2e_* databases, so the user needs CREATE/DROP on those names locally.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/your_database"

# 32+ random bytes. Keys the hashes of session / activation / reset tokens stored in the DB.
# Rotating it signs everyone out and invalidates outstanding invitation links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Encrypts the authenticator-app (MFA) secrets of ADMIN and SUPER_ADMIN accounts. 32+ characters.
# club-joia-300-next (the sales dashboard) must have the SAME value: it checks the same codes.
# Admins cannot sign in without it. Changing it makes every admin set up their authenticator again.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MFA_ENCRYPTION_KEY=""

# 32+ random bytes. HMAC key for QR access tokens. Different from AUTH_SECRET.
QR_SIGNING_SECRET=""
# During a key rotation set this to the old QR_SIGNING_SECRET for at least QR_TOKEN_TTL_SECONDS,
# so QR codes already on members' screens keep validating. Remove afterwards.
# Leave it commented out otherwise: an empty value fails validation (32+ characters required).
# QR_SIGNING_SECRET_PREVIOUS=""
# Lifetime of a QR token in seconds (30–3600). Member screens refresh at ~60% of this.
QR_TOKEN_TTL_SECONDS=300

# Public base URL (used in activation / reset links). Use https:// in production — this also
# enables HSTS and upgrade-insecure-requests.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Web Push (VAPID). Generate with: npm run push:keys
# Without these, in-app notifications still work and push is shown as "not configured".
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:concierge@your-domain.example"

# File storage for profile photos and concierge attachments.
#   local → STORAGE_LOCAL_DIR on the server's disk (development / single-server hosting). In production
#           use an absolute path OUTSIDE the site folder, e.g. /home/forge/joia-storage/uploads,
#           so uploads survive deployments.
#   s3    → any S3-compatible bucket: AWS S3, Cloudflare R2, Supabase Storage (S3 API), MinIO
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Email (activation / reset links, staff concierge alerts).
#   console → logged only, NOT delivered (default; admins get one-time links in the UI instead)
#   smtp    → any SMTP server (Microsoft 365, Google Workspace, SES, Postmark…) via SMTP_URL
#   resend  → Resend API via RESEND_API_KEY
EMAIL_DRIVER="console"
EMAIL_FROM="CLUB JOIA 300 <no-reply@your-domain.example>"
SMTP_URL=""               # e.g. smtps://user:password@smtp.your-provider.example:465
RESEND_API_KEY=""

# WhatsApp alerts to staff (new / assigned concierge requests).
#   console → logged only, NOT delivered (default)
#   twilio  → Twilio WhatsApp. Business-initiated messages need a Meta-approved template:
#             set TWILIO_WHATSAPP_CONTENT_SID (variables {{1}} title, {{2}} details, {{3}} link).
WHATSAPP_DRIVER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""   # e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=""

# IP allowlist: when set, only these addresses reach the app at all (every page, API and file);
# everyone else gets 403. Comma or space separated addresses and CIDR ranges. Empty = off.
# The address is the last X-Forwarded-For entry (added by nginx): the app must listen on 127.0.0.1
# only, behind nginx. Members and staff outside the list are locked out too.
# e.g. IP_ALLOWLIST="127.0.0.1, ::1, 203.0.113.7, 10.0.0.0/8"
IP_ALLOWLIST=""

# Development only: extra hostnames allowed to load the dev server (comma separated), e.g. a tunnel.
# Private LAN ranges are already allowed for `npm run dev:lan`.
DEV_ALLOWED_ORIGINS=""

# Bearer secret for GET /api/cron/notifications (scheduled notifications). 16+ chars.
# Required in production for scheduled notifications; an empty value fails validation, so keep
# it commented out until you set a real one.
# CRON_SECRET=""

# Future-phase feature flags (all off in V1).
FEATURE_MEMBER_NETWORK=false
FEATURE_MEETING_SCHEDULER=false
FEATURE_GLOBAL_CHAPTERS=false
FEATURE_PARTNER_BENEFITS=false
FEATURE_AI_CONCIERGE=false
