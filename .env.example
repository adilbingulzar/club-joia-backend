# ─────────────────────────────────────────────────────────────────────────────
# CLUB JOIA 300 — environment variables
# Copy to .env for local development. NEVER commit real values.
# Production values belong in your host's secret manager (e.g. Vercel → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (runtime + migrations).
# Local default matches `npm run db:start`. Production: managed Postgres (Neon, Supabase, RDS…).
# For pooled serverless connections use the provider's pooled URL here.
DATABASE_URL="postgres://joia:joia-local-dev-only@localhost:54329/joia_dev"

# Server for integration/E2E tests. Tests create and drop their own throwaway databases on this
# server — they never reset or modify the database named in the URL. Must differ from DATABASE_URL.
TEST_DATABASE_URL="postgres://joia:joia-local-dev-only@localhost:54329/joia_test"

# 32+ random bytes. Keys the hashes of session / activation / reset tokens stored in the DB.
# Rotating it signs everyone out and invalidates outstanding invitation links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# 32+ random bytes. HMAC key for QR access tokens. Different from AUTH_SECRET.
QR_SIGNING_SECRET=""
# During a key rotation set this to the old QR_SIGNING_SECRET for at least QR_TOKEN_TTL_SECONDS,
# so QR codes already on members' screens keep validating. Remove afterwards.
QR_SIGNING_SECRET_PREVIOUS=""
# Lifetime of a QR token in seconds (30–3600). Member screens refresh at ~60% of this.
QR_TOKEN_TTL_SECONDS=300

# Public base URL (used in activation / reset links). Use https:// in production — this also
# enables HSTS and upgrade-insecure-requests.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Web Push (VAPID). Generate with: npm run push:keys
# Without these, in-app notifications still work and push is shown as "not configured".
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:concierge@your-domain.example"

# File storage for profile photos and concierge attachments.
#   local → STORAGE_LOCAL_DIR on the server's disk (development / single-server hosting only)
#   s3    → any S3-compatible bucket: AWS S3, Cloudflare R2, Supabase Storage (S3 API), MinIO
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Email (activation / reset links, staff concierge alerts).
#   console → logged only, NOT delivered (default; admins get one-time links in the UI instead)
#   smtp    → any SMTP server (Microsoft 365, Google Workspace, SES, Postmark…) via SMTP_URL
#   resend  → Resend API via RESEND_API_KEY
EMAIL_DRIVER="console"
EMAIL_FROM="CLUB JOIA 300 <no-reply@your-domain.example>"
SMTP_URL=""               # e.g. smtps://user:password@smtp.your-provider.example:465
RESEND_API_KEY=""

# WhatsApp alerts to staff (new / assigned concierge requests).
#   console → logged only, NOT delivered (default)
#   twilio  → Twilio WhatsApp. Business-initiated messages need a Meta-approved template:
#             set TWILIO_WHATSAPP_CONTENT_SID (variables {{1}} title, {{2}} details, {{3}} link).
WHATSAPP_DRIVER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""   # e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=""

# Development only: extra hostnames allowed to load the dev server (comma separated), e.g. a tunnel.
# Private LAN ranges are already allowed for `npm run dev:lan`.
DEV_ALLOWED_ORIGINS=""

# Bearer secret for GET /api/cron/notifications (scheduled notifications). 16+ chars.
CRON_SECRET=""

# Future-phase feature flags (all off in V1).
FEATURE_MEMBER_NETWORK=false
FEATURE_MEETING_SCHEDULER=false
FEATURE_GLOBAL_CHAPTERS=false
FEATURE_PARTNER_BENEFITS=false
FEATURE_AI_CONCIERGE=false
